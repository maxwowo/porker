{
  "name": "porker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,rooms,pages -c magenta,green,blue \"npm:dev:web\" \"npm:dev:rooms\" \"npm:dev:pages\"",
    "dev:web": "vite",
    "dev:rooms": "wrangler dev -c worker/wrangler.toml --port 8787 --persist-to .wrangler/rooms",
    "dev:pages": "wrangler pages dev dist --port 8788 --do ROOMS=Room@porker-rooms --persist-to .wrangler/pages",
    "predev": "npm run build",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.functions.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tests/worker/tsconfig.json --noEmit",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "deploy:rooms": "wrangler deploy -c worker/wrangler.toml",
    "deploy:web": "wrangler pages deploy dist --project-name porker-app --branch main",
    "deploy": "npm run build && npm run deploy:rooms && npm run deploy:web"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261109.1": true
  }
}
